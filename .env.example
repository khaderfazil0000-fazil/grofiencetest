# ==========================================
# Grofience - Environment Variables
# ==========================================
# Copy this file to .env.local and fill in real values
# NEVER commit .env or .env.local to git

# MongoDB connection string
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=grofience

# JWT secret (generate a strong random string for production)
JWT_SECRET=replace_this_with_a_long_random_string_in_production

# Public base URL of the deployed app (used for email verification links)
# Local:    http://localhost:3000
# Vercel:   https://your-app.vercel.app  ← NO trailing slash
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── RESEND EMAIL (Recommended — works on Vercel) ─────────────────────────────
# Sign up free at https://resend.com → API Keys → Create Key
# ⚠️  FREE TIER LIMIT: Without a verified custom domain, OTP emails only
#     reach the Resend account owner's email. To send to ALL users you must
#     verify a domain at https://resend.com/domains and use it as RESEND_FROM.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Use onboarding@resend.dev (no setup) OR your verified domain address:
RESEND_FROM=onboarding@resend.dev

# ── EMAIL (Nodemailer / Gmail SMTP fallback) ─────────────────────────────────
# ⚠️  Does NOT work on Vercel (SMTP ports are blocked). Use Resend above instead.
# Gmail: enable 2FA → https://myaccount.google.com/apppasswords → create App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=Grofience <your-gmail@gmail.com>

# ── ADMIN PANEL ───────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe@StrongPassword123
ADMIN_JWT_SECRET=replace_this_with_another_long_random_string

# ── SMS / TWILIO (optional) ───────────────────────────────────────────────────
# Only needed if you want OTP via SMS in addition to email
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── reCAPTCHA (Spam/Bot Protection on Signup) ────────────────────────────────
# 1. Go to https://www.google.com/recaptcha/admin → Create Site → v2 Checkbox
# 2. Add your domain (or localhost for testing)
# 3. Copy the SITE KEY here (the SECRET KEY is verified server-side if you add that logic)
# ⚠️  Without a real key, the app uses Google's test keys which bypass all checks.
#     REPLACE BEFORE LAUNCH.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# ^ Replace the above value with your real Site Key from Google reCAPTCHA admin

# ── CURRENCY ──────────────────────────────────────────────────────────────────
# New accounts default to INR (₹). Users can change this in Settings.
# No env var needed — this is controlled per-user in the database.

